# ============================================================================
# MTDRB Admin - Environment Variables
# ============================================================================
# 
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
#
# ============================================================================

# Supabase Configuration (REQUIRED for production)
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Application URL (REQUIRED for production)
# This is the public URL where your application is hosted
# Used for generating share links, email templates, etc.
VITE_APP_URL=https://your-domain.com

# Optional bot protection for sign-up / sign-in / password reset: the Cloudflare
# Turnstile SITE key (public). Must be paired with CAPTCHA enabled in Supabase
# Auth using the SECRET key - set both or neither (DEPLOYMENT.md, "Self-serve
# sign-up").
VITE_TURNSTILE_SITE_KEY=

# Optional: For Edge Functions and server-side operations
# WARNING: Never expose the service role key in client-side code
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Development Options
# ============================================================================

# Force real Supabase client in development (default: uses mock client)
# Set to "true" to test with real backend in dev mode
# VITE_FORCE_REAL_CLIENT=false

# ============================================================================
# Application Configuration
# ============================================================================

VITE_APP_NAME=MTDRB Fitness
VITE_DEFAULT_LANGUAGE=en
# Region defaults for a gym that has not configured itself yet. Leave these
# unset for a global product: each gym chooses its own country, currency,
# timezone and tax in the setup wizard (pre-filled from the browser's timezone).
# Setting them pre-selects one country for EVERY new gym.
# VITE_DEFAULT_TIMEZONE=
# VITE_DEFAULT_CURRENCY=
# VITE_DEFAULT_COUNTRY_CODE=
# VITE_DEFAULT_VAT_RATE=
VITE_PLATFORM_CURRENCY=BHD
VITE_STARTER_PLAN_NAME=Starter
VITE_STARTER_PRICE=20
VITE_STARTER_EXTRA_LOCATION_PRICE=10
VITE_PRO_PLAN_NAME=Pro
VITE_PRO_PRICE=35
VITE_PRO_EXTRA_LOCATION_PRICE=15

# Paddle Billing (platform subscription checkout). Safe to expose -- a Paddle
# client token and price IDs are not secrets. See DEPLOYMENT.md's "Payment
# gateway (Paddle)" section.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_STARTER_PRICE_ID=
VITE_PADDLE_PRO_PRICE_ID=
# Checkout is OPEN whenever the Paddle values above are set. Set this to exactly
# "false" to pause new subscriptions. The build fails if checkout would be open
# but a Paddle value is missing or the token doesn't match the environment.
# VITE_CHECKOUT_ENABLED=false

# Optional: production error monitoring (Sentry). Leave unset to disable --
# the app runs normally either way, it just won't report runtime errors.
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Node Environment (automatically set by build process)
# NODE_ENV=production

# ============================================================================
# Notes
# ============================================================================
# 
# 1. In development mode (npm run dev), the app uses a mock Supabase client
#    unless VITE_FORCE_REAL_CLIENT is set to "true"
#
# 2. In production builds (npm run build), VITE_SUPABASE_URL and 
#    VITE_SUPABASE_ANON_KEY are REQUIRED and will cause the app to fail
#    if missing
#
# 3. The service role key should ONLY be used in secure server-side contexts
#    (Edge Functions, API routes, etc.) and NEVER in client-side code
#
# ============================================================================ 