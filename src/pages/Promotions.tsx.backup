import React, { useState, useEffect } from 'react';
import { useAuth } from '../contexts/AuthContext';
import { 
  FiGift, FiZap, FiBarChart, FiEdit3, FiSettings, FiTrendingUp, 
  FiTarget, FiUsers, FiDollarSign, FiCpu
} from 'react-icons/fi';
import { SmartPromotionsDashboard } from '../components/promotions/SmartPromotionsDashboard';
import { PromotionAutomationEngine } from '../components/promotions/PromotionAutomationEngine';
import { SmartPromotionAnalytics } from '../components/promotions/SmartPromotionAnalytics';
import { PromotionBuilder } from '../components/promotions/PromotionBuilder';
import { PromotionManagement } from '../components/promotions/PromotionManagement';

interface PromotionStats {
  activePromotions: number;
  totalConversions: number;
  conversionRate: number;
  totalRevenue: number;
  engagedMembers: number;
  automationROI: number;
}

type PromotionView = 'dashboard' | 'automation' | 'analytics' | 'builder' | 'management';

export default function Promotions() {
  const { user } = useAuth();
  const [currentView, setCurrentView] = useState<PromotionView>('dashboard');
  const [stats, setStats] = useState<PromotionStats>({
    activePromotions: 0,
    totalConversions: 0,
    conversionRate: 0,
    totalRevenue: 0,
    engagedMembers: 0,
    automationROI: 0
  });
  const [refreshKey, setRefreshKey] = useState(0);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (user) {
      fetchStats();
    }
  }, [user, refreshKey]);

  const fetchStats = async () => {
    setLoading(true);
    try {
      // Simulate fetching promotion statistics
      const mockStats: PromotionStats = {
        activePromotions: 8,
        totalConversions: 347,
        conversionRate: 24.5,
        totalRevenue: 12450,
        engagedMembers: 1289,
        automationROI: 340
      };
      
      setStats(mockStats);
    } catch (error) {
      console.error('Error fetching promotion stats:', error);
    } finally {
      setLoading(false);
    }
  };

  const smartViews = [
    { 
      id: 'dashboard', 
      name: 'Smart Dashboard', 
      icon: FiCpu, 
      description: 'AI-powered promotion insights',
      highlight: 'Primary Feature',
      color: 'from-purple-600 to-pink-600'
    },
    { 
      id: 'automation', 
      name: 'Automation Engine', 
      icon: FiZap, 
      description: 'Automated promotion workflows',
      color: 'from-blue-600 to-indigo-600'
    },
    { 
      id: 'analytics', 
      name: 'Smart Analytics', 
      icon: FiBarChart, 
      description: 'Performance insights & ROI',
      color: 'from-emerald-600 to-green-600'
    },
    { 
      id: 'builder', 
      name: 'Promotion Builder', 
      icon: FiEdit3, 
      description: 'Create & customize campaigns',
      color: 'from-orange-600 to-red-600'
    },
    { 
      id: 'management', 
      name: 'Campaign Management', 
      icon: FiSettings, 
      description: 'Manage all promotions',
      color: 'from-teal-600 to-cyan-600'
    },
  ];

  const renderCurrentView = () => {
    switch (currentView) {
      case 'dashboard':
        return <SmartPromotionsDashboard refreshKey={refreshKey} stats={stats} />;
      case 'automation':
        return <PromotionAutomationEngine refreshKey={refreshKey} />;
      case 'analytics':
        return <SmartPromotionAnalytics refreshKey={refreshKey} />;
      case 'builder':
        return <PromotionBuilder refreshKey={refreshKey} />;
      case 'management':
        return <PromotionManagement refreshKey={refreshKey} stats={stats} />;
      default:
        return <SmartPromotionsDashboard refreshKey={refreshKey} stats={stats} />;
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-600"></div>
      </div>
    );
  }

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-4">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Smart Promotion Management</h1>
            <p className="text-gray-600 mt-1">
              AI-powered promotion automation with intelligent campaigns and member engagement optimization
            </p>
          </div>
          <div className="flex items-center gap-4">
            {/* Quick Stats */}
            <div className="hidden md:flex items-center gap-6 text-sm">
              <div className="flex items-center gap-2">
                <div className="bg-purple-100 p-2 rounded-lg">
                  <FiGift className="text-purple-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.activePromotions}</div>
                  <div className="text-gray-500">Active</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-green-100 p-2 rounded-lg">
                  <FiTarget className="text-green-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.conversionRate}%</div>
                  <div className="text-gray-500">Conversion</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-blue-100 p-2 rounded-lg">
                  <FiDollarSign className="text-blue-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">${(stats.totalRevenue / 1000).toFixed(1)}k</div>
                  <div className="text-gray-500">Revenue</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-orange-100 p-2 rounded-lg">
                  <FiTrendingUp className="text-orange-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.automationROI}%</div>
                  <div className="text-gray-500">ROI</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Smart Navigation */}
        <div className="bg-white rounded-2xl shadow-lg p-2 border border-gray-200">
          <div className="flex space-x-1 overflow-x-auto">
            {smartViews.map((view) => (
              <button
                key={view.id}
                onClick={() => setCurrentView(view.id as PromotionView)}
                className={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all whitespace-nowrap relative ${
                  currentView === view.id
                    ? `bg-gradient-to-r ${view.color} text-white shadow-lg`
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <view.icon className={`${currentView === view.id ? 'text-white' : 'text-gray-500'}`} />
                <div className="text-left">
                  <div className="font-semibold">{view.name}</div>
                  <div className={`text-xs ${currentView === view.id ? 'text-purple-100' : 'text-gray-500'}`}>
                    {view.description}
                  </div>
                </div>
                {view.highlight && currentView === view.id && (
                  <span className="absolute -top-1 -right-1 bg-yellow-400 text-yellow-900 text-xs px-1 py-0.5 rounded-full font-bold">
                    ⭐
                  </span>
                )}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Dynamic Content */}
      <div className="transition-all duration-300">
        {renderCurrentView()}
      </div>

      {/* Promotion Performance Summary */}
      <div className="mt-8 bg-gradient-to-r from-purple-600 to-pink-600 rounded-3xl p-6 text-white">
        <div className="flex items-center justify-between">
          <div>
            <h2 className="text-2xl font-bold mb-2">Promotion Performance Summary</h2>
            <p className="text-purple-100">
              Your smart promotion system has generated <span className="font-bold">${stats.totalRevenue.toLocaleString()}</span> in revenue 
              with a <span className="font-bold">{stats.conversionRate}%</span> conversion rate this month.
            </p>
          </div>
          <div className="hidden md:flex items-center space-x-6">
            <div className="text-center">
              <div className="text-3xl font-bold">{stats.totalConversions}</div>
              <div className="text-purple-200 text-sm">Total Conversions</div>
            </div>
            <div className="text-center">
              <div className="text-3xl font-bold">{stats.engagedMembers}</div>
              <div className="text-purple-200 text-sm">Engaged Members</div>
            </div>
            <div className="text-center">
              <div className="text-3xl font-bold">{stats.automationROI}%</div>
              <div className="text-purple-200 text-sm">Automation ROI</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
} 