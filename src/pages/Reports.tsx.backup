import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { supabase } from '../supabaseClient';
import { useAuth } from '../contexts/AuthContext';
import { 
  FiFileText, FiDownload, FiCalendar, FiTrendingUp, FiUsers, FiDollarSign,
  FiBarChart, FiCpu, FiZap, FiClock, FiTarget, FiActivity, FiMail, FiSettings
} from 'react-icons/fi';
import SmartReportsDashboard from '../components/reports/SmartReportsDashboard';
import ReportAutomationEngine from '../components/reports/ReportAutomationEngine';
import SmartReportAnalytics from '../components/reports/SmartReportAnalytics';
import ReportGenerator from '../components/reports/ReportGenerator';
import ScheduledReports from '../components/reports/ScheduledReports';

interface ReportStats {
  totalReports: number;
  automatedReports: number;
  scheduledToday: number;
  totalDownloads: number;
}

type ReportView = 'dashboard' | 'automation' | 'analytics' | 'generator' | 'scheduled';

export default function Reports() {
  const { user } = useAuth();
  const [currentView, setCurrentView] = useState<ReportView>('dashboard');
  const [stats, setStats] = useState<ReportStats>({
    totalReports: 0,
    automatedReports: 0,
    scheduledToday: 0,
    totalDownloads: 0
  });
  const [refreshKey, setRefreshKey] = useState(0);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (user) {
      fetchStats();
    }
  }, [user, refreshKey]);

  const fetchStats = async () => {
    setLoading(true);
    try {
      // Simulate fetching report statistics
      // In real implementation, these would come from a reports table
      const mockStats: ReportStats = {
        totalReports: 47,
        automatedReports: 23,
        scheduledToday: 8,
        totalDownloads: 1247
      };
      
      setStats(mockStats);
    } catch (error) {
      console.error('Error fetching report stats:', error);
    } finally {
      setLoading(false);
    }
  };

  const smartViews = [
    { 
      id: 'dashboard', 
      name: 'Smart Dashboard', 
      icon: FiCpu, 
      description: 'AI-powered report insights',
      highlight: 'Primary Feature',
      color: 'from-blue-600 to-indigo-600'
    },
    { 
      id: 'automation', 
      name: 'Report Automation', 
      icon: FiZap, 
      description: 'Automated report generation',
      color: 'from-purple-600 to-pink-600'
    },
    { 
      id: 'analytics', 
      name: 'Report Analytics', 
      icon: FiBarChart, 
      description: 'Performance & insights',
      color: 'from-emerald-600 to-green-600'
    },
    { 
      id: 'generator', 
      name: 'Report Generator', 
      icon: FiFileText, 
      description: 'Create custom reports',
      color: 'from-orange-600 to-red-600'
    },
    { 
      id: 'scheduled', 
      name: 'Scheduled Reports', 
      icon: FiCalendar, 
      description: 'Manage scheduled reports',
      color: 'from-teal-600 to-cyan-600'
    },
  ];

  const renderCurrentView = () => {
    switch (currentView) {
      case 'dashboard':
        return <SmartReportsDashboard refreshKey={refreshKey} stats={stats} />;
      case 'automation':
        return <ReportAutomationEngine refreshKey={refreshKey} />;
      case 'analytics':
        return <SmartReportAnalytics refreshKey={refreshKey} />;
      case 'generator':
        return <ReportGenerator refreshKey={refreshKey} />;
      case 'scheduled':
        return <ScheduledReports refreshKey={refreshKey} />;
      default:
        return <SmartReportsDashboard refreshKey={refreshKey} stats={stats} />;
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-600"></div>
      </div>
    );
  }

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-4">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Smart Reports & Analytics</h1>
            <p className="text-gray-600 mt-1">
              AI-powered reporting with automated insights and intelligent business analytics
            </p>
          </div>
          <div className="flex items-center gap-4">
            {/* Quick Stats */}
            <div className="hidden md:flex items-center gap-6 text-sm">
              <div className="flex items-center gap-2">
                <div className="bg-blue-100 p-2 rounded-lg">
                  <FiFileText className="text-blue-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.totalReports}</div>
                  <div className="text-gray-500">Total Reports</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-purple-100 p-2 rounded-lg">
                  <FiZap className="text-purple-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.automatedReports}</div>
                  <div className="text-gray-500">Automated</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-green-100 p-2 rounded-lg">
                  <FiCalendar className="text-green-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.scheduledToday}</div>
                  <div className="text-gray-500">Today</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-orange-100 p-2 rounded-lg">
                  <FiDownload className="text-orange-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.totalDownloads}</div>
                  <div className="text-gray-500">Downloads</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Smart Navigation */}
        <div className="bg-white rounded-2xl shadow-lg p-2 border border-gray-200">
          <div className="flex space-x-1 overflow-x-auto">
            {smartViews.map((view) => (
              <button
                key={view.id}
                onClick={() => setCurrentView(view.id as ReportView)}
                className={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all whitespace-nowrap relative ${
                  currentView === view.id
                    ? `bg-gradient-to-r ${view.color} text-white shadow-lg`
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <view.icon className={`${currentView === view.id ? 'text-white' : 'text-gray-500'}`} />
                <div className="text-left">
                  <div className="font-semibold flex items-center gap-2">
                    {view.name}
                    {view.highlight && currentView === view.id && (
                      <span className="bg-white bg-opacity-20 text-white text-xs px-2 py-1 rounded-full">
                        {view.highlight}
                      </span>
                    )}
                  </div>
                  <div className={`text-xs ${currentView === view.id ? 'text-white text-opacity-90' : 'text-gray-500'}`}>
                    {view.description}
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Content */}
      <motion.div
        key={currentView}
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.3 }}
      >
        {renderCurrentView()}
      </motion.div>
    </div>
  );
} 