import React, { useEffect, useState, useRef } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import { supabase } from '../supabaseClient';
import { FiUsers, FiUserPlus, FiDownload, FiSearch, FiFilter, FiCalendar, FiDollarSign, FiFileText, FiTrendingUp, FiCheckCircle, FiZap, FiActivity, FiEdit, FiPlus, FiBell } from 'react-icons/fi';
import MemberTable from '../components/members/MemberTable';
import MemberProfileDrawer from '../components/members/MemberProfileDrawer';
import MemberFormModal from '../components/members/MemberFormModal';
import MemberImportModal from '../components/members/MemberImportModal';
import { AppleButton, AppleButtonGroup } from '../components/AppleStyleModal';
import MemberKPICards from '../components/members/MemberKPICards';
import SmartMemberDashboard from '../components/members/SmartMemberDashboard';
import AutomationEngine from '../components/members/AutomationEngine';
import SmartMemberAnalytics from '../components/members/SmartMemberAnalytics';
import { Member } from '../types';
import { useTranslation } from 'react-i18next';
import { useUI } from '../contexts/UIContext';
import { toast } from 'react-hot-toast';
import DuplicateCheckModal from '../components/members/DuplicateCheckModal';
import { 
  PageLayout, 
  SmartCard, 
  SmartButton, 
  FilterBar, 
  Section,
  StatsGrid,
  KPICard,
  SmartTable,
  SmartLoading,
  EmptyState
} from "../components/ui";
import { QuickNavigation, SmartSuggestions, usePageNavigation } from "../components/ui/SmartNavigation";

export default function Members() {
  const { t } = useTranslation();
  const [user, setUser] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [showAddModal, setShowAddModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [showImportModal, setShowImportModal] = useState(false);
  const [selectedMember, setSelectedMember] = useState<Member | null>(null);
  const [editingMember, setEditingMember] = useState<Member | null>(null);
  const [deletingMember, setDeletingMember] = useState<Member | null>(null);
  const [deleteLoading, setDeleteLoading] = useState(false);
  const [refreshKey, setRefreshKey] = useState(0);
  const [members, setMembers] = useState<Member[]>([]);
  const [kpiStats, setKpiStats] = useState({ total: 0, active: 0, expired: 0, inactive: 0, newThisMonth: 0 });
  const [searchTerm, setSearchTerm] = useState('');
  const [statusFilter, setStatusFilter] = useState<'all' | 'active' | 'trial' | 'paused' | 'cancelled'>('all');
  const [isFormModalOpen, setIsFormModalOpen] = useState(false);
  const [isDuplicateModalOpen, setIsDuplicateModalOpen] = useState(false);
  const [duplicateInfo, setDuplicateInfo] = useState<any>(null);
  const [activeView, setActiveView] = useState<'dashboard' | 'automation' | 'analytics' | 'list'>('dashboard');
  const tableRef = useRef<{ refetch: () => void } | null>(null);
  const navigate = useNavigate();
  const { currentPage } = usePageNavigation();

  // Member KPIs for the new design system
  const memberKPIs = [
    {
      title: "Total Members",
      value: kpiStats.total,
      change: "+12.5%",
      trend: "up" as const,
      icon: <FiUsers className="h-6 w-6" />,
      color: "blue" as const
    },
    {
      title: "New This Month",
      value: kpiStats.newThisMonth,
      change: "+18.2%", 
      trend: "up" as const,
      icon: <FiUserPlus className="h-6 w-6" />,
      color: "green" as const
    },
    {
      title: "Active Members",
      value: kpiStats.active,
      change: "+5.3%",
      trend: "up" as const,
      icon: <FiTrendingUp className="h-6 w-6" />,
      color: "purple" as const
    },
    {
      title: "At Risk",
      value: kpiStats.inactive,
      change: "-8.1%",
      trend: "down" as const,
      icon: <FiActivity className="h-6 w-6" />,
      color: "red" as const
    }
  ];

  const memberViews = [
    {
      id: "dashboard",
      name: "Smart Dashboard",
      icon: <FiTrendingUp className="h-5 w-5" />,
      description: "AI insights and member analytics"
    },
    {
      id: "automation",
      name: "Automation",
      icon: <FiZap className="h-5 w-5" />,
      description: "Automated workflows and campaigns"
    },
    {
      id: "analytics",
      name: "Analytics",
      icon: <FiCalendar className="h-5 w-5" />,
      description: "Detailed member insights"
    },
    {
      id: "list",
      name: "Member List",
      icon: <FiUsers className="h-5 w-5" />,
      description: "Complete member directory"
    }
  ];

  const contextualActions = [
    {
      label: "Add Member",
      icon: <FiPlus className="h-4 w-4" />,
      onClick: () => setShowAddModal(true),
      variant: "primary" as const
    },
    {
      label: "Import Members",
      icon: <FiDownload className="h-4 w-4" />,
      onClick: () => setShowImportModal(true),
      variant: "secondary" as const
    },
    {
      label: "Send Notification",
      icon: <FiBell className="h-4 w-4" />,
      onClick: () => console.log("Send notification"),
      variant: "ghost" as const
    }
  ];

  useEffect(() => {
    supabase.auth.getUser().then(({ data }) => {
      if (!data.user) {
        navigate('/login');
      } else if (!data.user.user_metadata || !data.user.user_metadata.paid) {
        navigate('/subscribe');
      } else {
        setUser(data.user);
      }
      setLoading(false);
    });
  }, [navigate]);

  useEffect(() => {
    async function fetchAllMembers() {
      const { data, error } = await supabase.from('members').select('*');
      if (!error && data) {
        setMembers(data);
        // Calculate KPI stats for the entire list
        const total = data.length;
        const active = data.filter(m => m.status === 'active').length;
        const expired = data.filter(m => m.status === 'expired').length;
        const inactive = data.filter(m => m.status === 'inactive').length;
        const now = new Date();
        const newThisMonth = data.filter(m => {
          const joined = new Date(m.joined_at || m.created_at);
          return joined.getMonth() === now.getMonth() && joined.getFullYear() === now.getFullYear();
        }).length;
        setKpiStats({ total, active, expired, inactive, newThisMonth });
      }
    }
    fetchAllMembers();
  }, [refreshKey]);

  if (loading) return null;

  // Logout handler
  const handleLogout = async () => {
    await supabase.auth.signOut();
    navigate('/login');
  };

  // Handlers for modals/drawers
  const handleAddMember = () => {
    setEditingMember(null);
    setIsFormModalOpen(true);
  };

  const handleEditMember = (member: Member) => {
    setEditingMember(member);
    setIsFormModalOpen(true);
  };

  const handleDeleteMember = (member: Member) => {
    setDeletingMember(member);
  };

  const handleDeleteConfirm = async () => {
    if (!deletingMember) return;
    
    setDeleteLoading(true);
    try {
      const { error } = await supabase
        .from('members')
        .delete()
        .eq('id', deletingMember.id);
        
      if (error) throw error;
      
      setRefreshKey(k => k + 1);
      setDeletingMember(null);
    } catch (error) {
      console.error('Error deleting member:', error);
      alert('Failed to delete member. Please try again.');
    } finally {
      setDeleteLoading(false);
    }
  };

  const handleMemberSaved = (member: Member) => {
    fetchMembers(); // Refresh the table
    if (tableRef.current) {
      tableRef.current.refetch();
    }
    toast.success(
      editingMember ? 
      '✅ Member updated successfully with smart features!' : 
      '🚀 Smart member created successfully!'
    );
  };

  const handleDuplicateDetected = (duplicateInfo: any) => {
    setDuplicateInfo(duplicateInfo);
    setIsDuplicateModalOpen(true);
  };

  const handleDuplicateResolved = () => {
    setIsDuplicateModalOpen(false);
    setDuplicateInfo(null);
    fetchMembers();
  };

  const handleImportMembers = () => {
    setShowImportModal(true);
  };

  const handleRowClick = (member: Member) => {
    setSelectedMember(member);
    // Provide user feedback about the smart profile opening
    toast(`🔍 Opening smart profile for ${member.name}`, {
      duration: 2000,
      style: {
        background: '#EBF5FF',
        color: '#1E40AF',
        border: '1px solid #BFDBFE'
      }
    });
  };

  const handleCloseDrawer = () => {
    setSelectedMember(null);
  };

  const handleCloseAddModal = () => {
    setIsFormModalOpen(false);
    setEditingMember(null);
  };

  const handleCloseEditModal = () => {
    setIsFormModalOpen(false);
    setEditingMember(null);
  };

  // Smart features handlers
  const handleMemberClick = (memberId: string) => {
    const member = members.find(m => m.id === memberId);
    if (member) {
      setSelectedMember(member);
    }
  };

  const handleAutomationTrigger = (automationId: string, memberId: string) => {
    toast.success(`🤖 Automation "${automationId}" triggered for member!`);
    // Here you would implement the actual automation trigger logic
  };

  const exportMembers = async () => {
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;

      // Get tenant ID
      let tenantId = session.user.user_metadata?.tenantId;
      
      if (!tenantId) {
        const { data: membershipData } = await supabase
          .from('memberships')
          .select('tenant_id')
          .eq('user_id', session.user.id)
          .single();
        
        if (membershipData) {
          tenantId = membershipData.tenant_id;
        }
      }

      if (!tenantId) {
        toast.error('No tenant ID found');
        return;
      }

      const { data, error } = await supabase
        .from('members')
        .select('*')
        .eq('tenant_id', tenantId);

      if (error) throw error;

      // Convert to CSV
      const csvContent = [
        // CSV Header with smart fields
        'Name,Gender,Email,Phone,Membership Status,Start Date,End Date,Fitness Level,Primary Goals,Goal Timeline,Height,Weight,Target Weight,Preferred Contact,Workout Reminders,Auto Intro,Welcome Sequence',
        ...data.map(member => [
          member.name || '',
          member.gender || '',
          member.email || '',
          member.phone || '',
          member.membership_status || '',
          member.start_date || '',
          member.end_date || '',
          member.fitness_level || '',
          Array.isArray(member.primary_goals) ? member.primary_goals.join('; ') : '',
          member.goal_timeline || '',
          member.height || '',
          member.weight || '',
          member.target_weight || '',
          member.preferred_contact_method || '',
          member.workout_reminders ? 'Yes' : 'No',
          member.auto_schedule_intro ? 'Yes' : 'No',
          member.send_welcome_sequence ? 'Yes' : 'No'
        ].join(','))
      ].join('\n');

      // Download
      const blob = new Blob([csvContent], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `members-export-${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      URL.revokeObjectURL(url);

      toast.success('📊 Smart member data exported successfully!');
    } catch (error) {
      console.error('Error exporting members:', error);
      toast.error('Failed to export members');
    }
  };

  // Filter members based on search and status
  const filteredMembers = members.filter(member => {
    const matchesSearch = member.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         member.email?.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         member.phone?.toLowerCase().includes(searchTerm.toLowerCase());
    
    const matchesStatus = statusFilter === 'all' || member.membership_status?.toLowerCase() === statusFilter;
    
    return matchesSearch && matchesStatus;
  });

  // Define fetchMembers function here
  const fetchMembers = async () => {
    const { data, error } = await supabase.from('members').select('*');
    if (!error && data) {
      setMembers(data);
      // Calculate KPI stats for the entire list
      const total = data.length;
      const active = data.filter(m => m.status === 'active').length;
      const expired = data.filter(m => m.status === 'expired').length;
      const inactive = data.filter(m => m.status === 'inactive').length;
      const now = new Date();
      const newThisMonth = data.filter(m => {
        const joined = new Date(m.joined_at || m.created_at);
        return joined.getMonth() === now.getMonth() && joined.getFullYear() === now.getFullYear();
      }).length;
      setKpiStats({ total, active, expired, inactive, newThisMonth });
    }
  };

  const renderActiveView = () => {
    if (loading) {
      return <SmartLoading message="Loading member data..." />;
    }

    switch (activeView) {
      case "dashboard":
        return <SmartMemberDashboard />;
      case "automation":
        return <AutomationEngine />;
      case "analytics":
        return <SmartMemberAnalytics />;
      case "list":
        return (
          <div className="space-y-6">
            {/* Search and Filters */}
            <FilterBar>
              <div className="flex-1 max-w-md">
                <div className="relative">
                  <FiSearch className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-4 w-4" />
                  <input
                    type="text"
                    placeholder="Search members..."
                    value={searchTerm}
                    onChange={(e) => setSearchTerm(e.target.value)}
                    className="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  />
                </div>
              </div>
              
              <select
                value={statusFilter}
                onChange={(e) => setStatusFilter(e.target.value as any)}
                className="px-4 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="all">All Members</option>
                <option value="active">Active</option>
                <option value="trial">Trial</option>
                <option value="paused">Paused</option>
                <option value="cancelled">Cancelled</option>
              </select>

              <SmartButton
                variant="ghost"
                size="sm"
                icon={<FiFilter className="h-4 w-4" />}
                onClick={() => console.log("Advanced filters")}
              >
                Filters
              </SmartButton>
            </FilterBar>

            {/* Member Table */}
            <SmartTable>
              <MemberTable
                ref={tableRef}
                onMemberClick={handleRowClick}
                onMemberEdit={handleEditMember}
                onMemberDelete={handleDeleteMember}
                searchTerm={searchTerm}
                statusFilter={statusFilter}
              />
            </SmartTable>
          </div>
        );
      default:
        return <SmartMemberDashboard />;
    }
  };

  return (
    <PageLayout
      title="Smart Member Management"
      subtitle="AI-powered member insights and automation"
      actions={
        <div className="flex items-center space-x-3">
          {contextualActions.map((action, index) => (
            <SmartButton
              key={index}
              variant={action.variant}
              size="sm"
              icon={action.icon}
              onClick={action.onClick}
            >
              {action.label}
            </SmartButton>
          ))}
        </div>
      }
    >
      {/* Quick Navigation */}
      <QuickNavigation currentPage={currentPage} />

      {/* Smart Suggestions */}
      <SmartSuggestions currentPage={currentPage} />

      {/* KPI Overview */}
      <Section title="Member Overview" subtitle="Real-time member statistics and trends">
        <StatsGrid columns={4}>
          {memberKPIs.map((kpi, index) => (
            <KPICard key={index} {...kpi} />
          ))}
        </StatsGrid>
      </Section>

      {/* View Navigation */}
      <SmartCard className="mb-6">
        <div className="flex items-center justify-between">
          <div className="flex space-x-1 bg-gray-100 p-1 rounded-2xl">
            {memberViews.map((view) => (
              <button
                key={view.id}
                onClick={() => setActiveView(view.id as any)}
                className={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 ${
                  activeView === view.id
                    ? "bg-white text-blue-600 shadow-sm"
                    : "text-gray-600 hover:text-gray-900"
                }`}
                title={view.description}
              >
                {view.icon}
                <span className="hidden md:inline">{view.name}</span>
              </button>
            ))}
          </div>
        </div>
      </SmartCard>

      {/* Active View Content */}
      {renderActiveView()}

      {/* Modals */}
      {isFormModalOpen && (
        <MemberFormModal
          isOpen={isFormModalOpen}
          onClose={handleCloseAddModal}
          member={editingMember}
          onMemberSaved={handleMemberSaved}
          onDuplicateDetected={handleDuplicateDetected}
        />
      )}

      {selectedMember && (
        <MemberProfileDrawer
          member={selectedMember}
          isOpen={!!selectedMember}
          onClose={handleCloseDrawer}
        />
      )}

      {showImportModal && (
        <MemberImportModal
          isOpen={showImportModal}
          onClose={() => setShowImportModal(false)}
          onImport={(data) => {
            console.log("Import data:", data);
            setShowImportModal(false);
            setRefreshKey(k => k + 1);
          }}
        />
      )}

      {isDuplicateModalOpen && duplicateInfo && (
        <DuplicateCheckModal
          isOpen={isDuplicateModalOpen}
          onClose={() => setIsDuplicateModalOpen(false)}
          duplicates={duplicateInfo.duplicates}
          newMember={duplicateInfo.newMember}
          onResolve={handleDuplicateResolved}
        />
      )}

      {/* Delete Confirmation */}
      {deletingMember && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <SmartCard className="max-w-md w-full mx-4">
            <div className="text-center">
              <div className="bg-red-100 p-3 rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center">
                <FiUsers className="h-6 w-6 text-red-600" />
              </div>
              <h3 className="text-lg font-semibold text-gray-900 mb-2">Delete Member</h3>
              <p className="text-gray-600 mb-6">
                Are you sure you want to delete {deletingMember.name}? This action cannot be undone.
              </p>
              <div className="flex space-x-3">
                <SmartButton
                  variant="secondary"
                  fullWidth
                  onClick={() => setDeletingMember(null)}
                >
                  Cancel
                </SmartButton>
                <SmartButton
                  variant="danger"
                  fullWidth
                  loading={deleteLoading}
                  onClick={handleDeleteConfirm}
                >
                  Delete
                </SmartButton>
              </div>
            </div>
          </SmartCard>
        </div>
      )}
    </PageLayout>
  );
} 