import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { supabase } from '../supabaseClient';
import { motion, AnimatePresence } from 'framer-motion';
import { 
  FiPlus, 
  FiTrendingUp, 
  FiTrendingDown,
  FiDollarSign, 
  FiAlertCircle,
  FiFileText,
  FiSettings,
  FiSearch,
  FiFilter,
  FiCheckCircle,
  FiCreditCard,
  FiUpload,
  FiDownload,
  FiChevronDown,
  FiPercent,
  FiZap,
  FiBarChart,
  FiList,
  FiGlobe,
  FiShield,
  FiCalendar
} from 'react-icons/fi';
import toast from 'react-hot-toast';

// Types
import { Invoice, Expense } from '../types';
import InvoicesSection from '../components/billing/InvoicesSection';
import { NewInvoiceModal } from '../components/billing/NewInvoiceModal';
import BillingKPICards from '../components/billing/BillingKPICards';
import { VatReportsSection } from '../components/billing/VatReportsSection';
import SmartBillingDashboard from '../components/billing/SmartBillingDashboard';
import BillingAutomationEngine from '../components/billing/BillingAutomationEngine';
import SmartBillingAnalytics from '../components/billing/SmartBillingAnalytics';

const STATUS_OPTIONS = ['All', 'Paid', 'Unpaid', 'Overdue'];
const TYPE_OPTIONS = ['All', 'Membership', 'PT', 'Product', 'Other'];
const PAYMENT_METHODS = ['All', 'Cash', 'Bank', 'POS', 'Other'];

// ===== SMART BILLING PAGE =====
export default function Billing() {
  const navigate = useNavigate();
  const [user, setUser] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  // Smart Billing Navigation
  const [currentView, setCurrentView] = useState<'vat-returns' | 'dashboard' | 'automation' | 'analytics' | 'billing'>('vat-returns');

  // Data state
  const [invoices, setInvoices] = useState<Invoice[]>([]);
  const [expenses, setExpenses] = useState<Expense[]>([]);
  const [clients, setClients] = useState<any[]>([]);
  const [classes, setClasses] = useState<any[]>([]);

  // UI state
  const [status, setStatus] = useState('');
  const [type, setType] = useState('');
  const [paymentMethod, setPaymentMethod] = useState('');
  const [dateFrom, setDateFrom] = useState('');
  const [dateTo, setDateTo] = useState('');
  const [search, setSearch] = useState('');
  const [showFilters, setShowFilters] = useState(false);
  const [exportOpen, setExportOpen] = useState(false);
  const [page, setPage] = useState(1);
  const [refreshKey, setRefreshKey] = useState(0);

  // Modal states
  const [showNewInvoiceModal, setShowNewInvoiceModal] = useState(false);
  const [editingInvoice, setEditingInvoice] = useState<Invoice | null>(null);

  // Check auth on mount
  useEffect(() => {
    supabase.auth.getUser().then(({ data }) => {
      if (!data.user) {
        navigate('/login');
      } else if (!data.user.user_metadata || !data.user.user_metadata.paid) {
        navigate('/subscribe');
      } else {
        setUser(data.user);
      }
      setLoading(false);
    });
  }, [navigate]);

  // Fetch data
  useEffect(() => {
    if (user) {
      fetchData();
    }
  }, [user]);

  const fetchData = async () => {
    try {
      setLoading(true);
      setError(null);

      // Fetch invoices
      const { data: invoiceData, error: invoiceError } = await supabase
        .from('invoices')
        .select('*')
        .order('created_at', { ascending: false });

      if (invoiceError) throw invoiceError;
      setInvoices(invoiceData || []);

      // Fetch expenses
      const { data: expenseData, error: expenseError } = await supabase
        .from('expenses')
        .select('*')
        .order('created_at', { ascending: false });

      if (expenseError) throw expenseError;
      setExpenses(expenseData || []);

      // Fetch clients (members)
      const { data: clientData, error: clientError } = await supabase
        .from('members')
        .select('id, name, email, phone')
        .order('name');

      if (clientError) throw clientError;
      setClients(clientData || []);

      // Fetch classes
      const { data: classData, error: classError } = await supabase
        .from('classes')
        .select('id, name, type')
        .order('name');

      if (classError) throw classError;
      setClasses(classData || []);

    } catch (err) {
      console.error('Error fetching data:', err);
      setError('Failed to load billing data');
    } finally {
      setLoading(false);
    }
  };

  const handleNewInvoice = () => {
    console.log('New Invoice button clicked!');
    console.log('Current showNewInvoiceModal state:', showNewInvoiceModal);
    setEditingInvoice(null);
    setShowNewInvoiceModal(true);
    console.log('Setting showNewInvoiceModal to true');
  };

  const handleCloseModal = () => {
    setShowNewInvoiceModal(false);
    setEditingInvoice(null);
  };

  const handleInvoiceSaved = () => {
    setRefreshKey(prev => prev + 1);
    handleCloseModal();
  };

  // Calculate totals
  const totalInvoiced = invoices.reduce((sum, invoice) => sum + (invoice.total || 0), 0);
  const totalPaid = invoices.filter(invoice => invoice.status === 'Paid').reduce((sum, invoice) => sum + (invoice.total || 0), 0);
  const outstanding = invoices.filter(invoice => invoice.status === 'Unpaid' || invoice.status === 'Overdue').reduce((sum, invoice) => sum + (invoice.total || 0), 0);
  const vatCollected = invoices.reduce((sum, invoice) => sum + (invoice.vat_total || 0), 0);
  // Credit Note Total: not supported in InvoiceType, set to 0 for now
  // TODO: Add support for credit notes if/when implemented in backend
  const creditNoteTotal = 0;
  const paidCount = invoices.filter(invoice => invoice.status === 'Paid').length;
  const outstandingCount = invoices.filter(invoice => invoice.status === 'Unpaid' || invoice.status === 'Overdue').length;
  const invoiceCount = invoices.length;

  const smartViews = [
    { 
      id: 'vat-returns', 
      name: 'VAT Returns', 
      icon: FiPercent, 
      description: 'GCC VAT compliance & returns',
      highlight: 'Primary Feature',
      color: 'from-emerald-600 to-green-600'
    },
    { 
      id: 'dashboard', 
      name: 'Smart Dashboard', 
      icon: FiZap, 
      description: 'AI-powered billing insights',
      color: 'from-blue-600 to-indigo-600'
    },
    { 
      id: 'automation', 
      name: 'Automation', 
      icon: FiZap, 
      description: 'Smart billing workflows',
      color: 'from-purple-600 to-pink-600'
    },
    { 
      id: 'analytics', 
      name: 'Analytics', 
      icon: FiBarChart, 
      description: 'Revenue forecasting & trends',
      color: 'from-orange-600 to-red-600'
    },
    { 
      id: 'billing', 
      name: 'Invoice Management', 
      icon: FiFileText, 
      description: 'Manage invoices & payments',
      color: 'from-gray-600 to-slate-600'
    },
  ];

  const renderCurrentView = () => {
    switch (currentView) {
      case 'vat-returns':
        return (
          <div className="space-y-6">
            {/* GCC VAT Returns Header */}
            <div className="bg-gradient-to-r from-emerald-50 to-green-50 rounded-2xl p-6 border border-emerald-200">
              <div className="flex items-center gap-3 mb-4">
                <div className="bg-emerald-500 p-3 rounded-xl">
                  <FiGlobe className="text-white text-2xl" />
                </div>
                <div>
                  <h3 className="text-xl font-bold text-emerald-900">GCC VAT Returns Management</h3>
                  <p className="text-emerald-700">Automated VAT compliance for UAE, Saudi Arabia, Bahrain & Gulf region</p>
                </div>
              </div>
              
              {/* Quick VAT Stats */}
              <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div className="bg-white rounded-xl p-4 border border-emerald-200">
                  <div className="flex items-center gap-2 mb-2">
                    <FiShield className="text-emerald-600" />
                    <span className="text-sm font-medium text-emerald-900">VAT Collected</span>
                  </div>
                  <p className="text-2xl font-bold text-emerald-600">{vatCollected.toFixed(2)} AED</p>
                  <p className="text-xs text-emerald-500">This period</p>
                </div>
                
                <div className="bg-white rounded-xl p-4 border border-emerald-200">
                  <div className="flex items-center gap-2 mb-2">
                    <FiCalendar className="text-blue-600" />
                    <span className="text-sm font-medium text-gray-900">Next Return Due</span>
                  </div>
                  <p className="text-2xl font-bold text-blue-600">15 Days</p>
                  <p className="text-xs text-gray-500">Q4 2024 VAT Return</p>
                </div>
                
                <div className="bg-white rounded-xl p-4 border border-emerald-200">
                  <div className="flex items-center gap-2 mb-2">
                    <FiCheckCircle className="text-green-600" />
                    <span className="text-sm font-medium text-gray-900">Compliance Status</span>
                  </div>
                  <p className="text-2xl font-bold text-green-600">100%</p>
                  <p className="text-xs text-green-500">All returns filed</p>
                </div>
                
                <div className="bg-white rounded-xl p-4 border border-emerald-200">
                  <div className="flex items-center gap-2 mb-2">
                    <FiDollarSign className="text-orange-600" />
                    <span className="text-sm font-medium text-gray-900">Net VAT Payable</span>
                  </div>
                  <p className="text-2xl font-bold text-orange-600">{(vatCollected * 0.8).toFixed(2)} AED</p>
                  <p className="text-xs text-orange-500">Estimated payment</p>
                </div>
              </div>
            </div>

            {/* VAT Reports Section */}
            <div className="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
              <div className="bg-gradient-to-r from-emerald-600 to-green-600 px-6 py-4">
                <h3 className="text-xl font-semibold text-white">VAT Transaction Reports</h3>
                <p className="text-emerald-100 text-sm mt-1">Detailed VAT analysis and compliance reports</p>
              </div>
              
              <VatReportsSection
                searchQuery={search}
                page={page}
                onPageChange={setPage}
                refreshKey={refreshKey}
                dateRange={dateFrom && dateTo ? [new Date(dateFrom), new Date(dateTo)] : [null, null]}
                tenantId={user?.user_metadata?.tenant_id || null}
                selectedStatus={status}
              />
            </div>
          </div>
        );
      case 'dashboard':
        return <SmartBillingDashboard refreshKey={refreshKey} />;
      case 'automation':
        return <BillingAutomationEngine refreshKey={refreshKey} />;
      case 'analytics':
        return <SmartBillingAnalytics refreshKey={refreshKey} />;
      case 'billing':
        return (
          <div className="space-y-6">
            {/* KPI Cards */}
            <BillingKPICards
              totalInvoiced={totalInvoiced}
              totalPaid={totalPaid}
              outstanding={outstanding}
              vatCollected={vatCollected}
              creditNoteTotal={creditNoteTotal}
              paidCount={paidCount}
              outstandingCount={outstandingCount}
              invoiceCount={invoiceCount}
            />
            
            {/* Invoice Management */}
            <div className="bg-white rounded-2xl shadow-lg border border-gray-200 p-6 overflow-x-auto">
              {/* Search, Filters, Actions Bar */}
              <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                <div className="flex-1 flex items-center gap-2 bg-blue-50 rounded-lg px-3 py-2">
                  <FiSearch className="text-blue-400" />
                  <input
                    type="text"
                    className="bg-transparent outline-none flex-1 text-blue-900 placeholder-blue-300 border-none shadow-none"
                    placeholder="Search by member name or trainer..."
                    value={search}
                    onChange={e => setSearch(e.target.value)}
                  />
                </div>
                <div className="flex gap-2 items-center">
                  <div className="relative">
                    <select
                      className="bg-blue-50 rounded-full px-4 py-2 text-blue-900 font-semibold border border-blue-100 appearance-none pr-8 focus:ring-2 focus:ring-blue-200 focus:border-blue-300 transition"
                      value={status}
                      onChange={e => setStatus(e.target.value)}
                    >
                      <option value="">All Statuses</option>
                      <option value="Paid">Paid</option>
                      <option value="Unpaid">Unpaid</option>
                      <option value="Overdue">Overdue</option>
                      <option value="Partial">Partial</option>
                      <option value="Refunded">Refunded</option>
                      <option value="Draft">Draft</option>
                      <option value="Cancelled">Cancelled</option>
                    </select>
                    <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-blue-400"><FiChevronDown /></span>
                  </div>
                  <div className="relative">
                    <select
                      className="bg-blue-50 rounded-full px-4 py-2 text-blue-900 font-semibold border border-blue-100 appearance-none pr-8 focus:ring-2 focus:ring-blue-200 focus:border-blue-300 transition"
                      value={type}
                      onChange={e => setType(e.target.value)}
                    >
                      <option value="">All Types</option>
                      <option value="Membership">Membership</option>
                      <option value="PT">PT</option>
                      <option value="Class">Class</option>
                      <option value="Facility">Facility</option>
                      <option value="Other">Other</option>
                    </select>
                    <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-blue-400"><FiChevronDown /></span>
                  </div>
                  <div className="relative">
                    <select
                      className="bg-blue-50 rounded-full px-4 py-2 text-blue-900 font-semibold border border-blue-100 appearance-none pr-8 focus:ring-2 focus:ring-blue-200 focus:border-blue-300 transition"
                      value={paymentMethod}
                      onChange={e => setPaymentMethod(e.target.value)}
                    >
                      <option value="">All Payments</option>
                      <option value="Cash">Cash</option>
                      <option value="Card">Card</option>
                      <option value="Bank Transfer">Bank Transfer</option>
                      <option value="Online">Online</option>
                      <option value="WhatsApp Pay">WhatsApp Pay</option>
                      <option value="Cheque">Cheque</option>
                      <option value="Digital Wallet">Digital Wallet</option>
                    </select>
                    <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-blue-400"><FiChevronDown /></span>
                  </div>
                  <button
                    className={`flex items-center gap-1 px-4 py-2 rounded-full border border-blue-100 bg-white text-blue-700 font-semibold transition hover:bg-blue-50`}
                    onClick={() => setShowFilters(f => !f)}
                    aria-expanded={showFilters}
                  >
                    <FiFilter className="text-blue-500" />
                    Advanced
                  </button>
                  <button
                    className="flex items-center gap-1 px-4 py-2 rounded-full border border-blue-100 bg-white text-blue-700 font-semibold transition hover:bg-blue-50"
                    onClick={() => alert('Import coming soon!')}
                  >
                    <FiUpload className="text-blue-500" /> Import
                  </button>
                  <div className="relative">
                    <button
                      className="flex items-center gap-1 px-4 py-2 rounded-full border border-blue-100 bg-white text-blue-700 font-semibold transition hover:bg-blue-50"
                      onClick={() => setExportOpen(e => !e)}
                      type="button"
                    >
                      <FiDownload className="text-blue-500" /> Export <FiChevronDown className="ml-1" />
                    </button>
                    {exportOpen && (
                      <div className="absolute right-0 mt-2 w-40 bg-white rounded-xl shadow-lg border border-blue-100 z-10">
                        <button
                          className="w-full text-left px-4 py-2 hover:bg-blue-50 text-blue-900 rounded-t-xl"
                          onClick={() => { setExportOpen(false); alert('Export CSV coming soon!'); }}
                        >
                          Export CSV
                        </button>
                        <button
                          className="w-full text-left px-4 py-2 hover:bg-blue-50 text-blue-900 rounded-b-xl"
                          onClick={() => { setExportOpen(false); alert('Export PDF coming soon!'); }}
                        >
                          Export PDF
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </div>
              {/* Advanced Filters Panel */}
              {showFilters && (
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 bg-blue-50 rounded-xl p-4 border border-blue-100">
                  <div>
                    <label className="block text-xs text-blue-500 mb-1">Start Date</label>
                    <input
                      type="date"
                      className="w-full rounded-lg border border-blue-200 px-3 py-2"
                      value={dateFrom}
                      onChange={e => setDateFrom(e.target.value)}
                    />
                  </div>
                  <div>
                    <label className="block text-xs text-blue-500 mb-1">End Date</label>
                    <input
                      type="date"
                      className="w-full rounded-lg border border-blue-200 px-3 py-2"
                      value={dateTo}
                      onChange={e => setDateTo(e.target.value)}
                    />
                  </div>
                  <div>
                    <label className="block text-xs text-blue-500 mb-1">Min Amount</label>
                    <input
                      type="number"
                      className="w-full rounded-lg border border-blue-200 px-3 py-2"
                      placeholder="0"
                      min={0}
                      // value and onChange can be implemented as needed
                    />
                  </div>
                </div>
              )}
              {/* Invoices Table */}
              <InvoicesSection
                searchQuery={search}
                selectedStatus={status}
                page={page}
                onPageChange={setPage}
                refreshKey={refreshKey}
              />
            </div>
          </div>
        );
      default:
        return <SmartBillingDashboard refreshKey={refreshKey} />;
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-blue-600 text-lg">Loading billing data...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-red-600 text-lg">Error: {error}</div>
      </div>
    );
  }

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-4">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Smart Billing & VAT Management</h1>
            <p className="text-gray-600 mt-1">
              GCC-compliant billing automation with intelligent VAT returns and financial insights
            </p>
          </div>
          <button
            onClick={handleNewInvoice}
            className="flex items-center gap-2 bg-blue-600 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-700 transition text-sm shadow"
          >
            <FiPlus /> New Invoice
          </button>
        </div>

        {/* Smart Navigation */}
        <div className="bg-white rounded-2xl shadow-lg p-2 border border-gray-200">
          <div className="flex space-x-1 overflow-x-auto">
            {smartViews.map((view) => (
              <button
                key={view.id}
                onClick={() => setCurrentView(view.id as any)}
                className={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all whitespace-nowrap relative ${
                  currentView === view.id
                    ? `bg-gradient-to-r ${view.color} text-white shadow-lg`
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <view.icon className={`${currentView === view.id ? 'text-white' : 'text-gray-500'}`} />
                <div className="text-left">
                  <div className="font-semibold flex items-center gap-2">
                    {view.name}
                    {view.highlight && currentView === view.id && (
                      <span className="bg-white bg-opacity-20 text-white text-xs px-2 py-1 rounded-full">
                        {view.highlight}
                      </span>
                    )}
                  </div>
                  <div className={`text-xs ${currentView === view.id ? 'text-white text-opacity-90' : 'text-gray-500'}`}>
                    {view.description}
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Content */}
      <motion.div
        key={currentView}
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.3 }}
      >
        {renderCurrentView()}
      </motion.div>

      {/* New Invoice Modal */}
      <NewInvoiceModal
        isOpen={showNewInvoiceModal}
        onClose={handleCloseModal}
        clients={clients}
        classes={classes}
        tenantId={user?.user_metadata?.tenantId || ''}
        onSave={handleInvoiceSaved}
        invoice={editingInvoice}
      />
    </div>
  );
}