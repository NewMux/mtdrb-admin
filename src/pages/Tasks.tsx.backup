import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { supabase } from '../supabaseClient';
import { useAuth } from '../contexts/AuthContext';
import { 
  FiCheckSquare, FiClock, FiUsers, FiTrendingUp, FiTarget, FiActivity, 
  FiCpu, FiZap, FiBarChart, FiPlus, FiCalendar, FiSettings
} from 'react-icons/fi';
import { SmartTasksDashboard } from '../components/tasks/SmartTasksDashboard';
import { TaskAutomationEngine } from '../components/tasks/TaskAutomationEngine';
import { SmartTaskAnalytics } from '../components/tasks/SmartTaskAnalytics';
import { TaskGenerator } from '../components/tasks/TaskGenerator';
import { TaskManagement } from '../components/tasks/TaskManagement';

interface TaskStats {
  totalTasks: number;
  completedTasks: number;
  overdueTasks: number;
  todaysTasks: number;
  automatedTasks: number;
  teamProductivity: number;
}

type TaskView = 'dashboard' | 'automation' | 'analytics' | 'generator' | 'management';

export default function Tasks() {
  const { user } = useAuth();
  const [currentView, setCurrentView] = useState<TaskView>('dashboard');
  const [stats, setStats] = useState<TaskStats>({
    totalTasks: 0,
    completedTasks: 0,
    overdueTasks: 0,
    todaysTasks: 0,
    automatedTasks: 0,
    teamProductivity: 0
  });
  const [refreshKey, setRefreshKey] = useState(0);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (user) {
      fetchStats();
    }
  }, [user, refreshKey]);

  const fetchStats = async () => {
    setLoading(true);
    try {
      // Simulate fetching task statistics
      // In real implementation, these would come from a tasks table
      const mockStats: TaskStats = {
        totalTasks: 247,
        completedTasks: 189,
        overdueTasks: 12,
        todaysTasks: 28,
        automatedTasks: 156,
        teamProductivity: 87
      };
      
      setStats(mockStats);
    } catch (error) {
      console.error('Error fetching task stats:', error);
    } finally {
      setLoading(false);
    }
  };

  const smartViews = [
    { 
      id: 'dashboard', 
      name: 'Smart Dashboard', 
      icon: FiCpu, 
      description: 'AI-powered task insights',
      highlight: 'Primary Feature',
      color: 'from-blue-600 to-indigo-600'
    },
    { 
      id: 'automation', 
      name: 'Task Automation', 
      icon: FiZap, 
      description: 'Automated workflows',
      color: 'from-purple-600 to-pink-600'
    },
    { 
      id: 'analytics', 
      name: 'Task Analytics', 
      icon: FiBarChart, 
      description: 'Performance insights',
      color: 'from-emerald-600 to-green-600'
    },
    { 
      id: 'generator', 
      name: 'Task Generator', 
      icon: FiPlus, 
      description: 'AI task creation',
      color: 'from-orange-600 to-red-600'
    },
    { 
      id: 'management', 
      name: 'Task Management', 
      icon: FiCheckSquare, 
      description: 'Manage all tasks',
      color: 'from-teal-600 to-cyan-600'
    },
  ];

  const renderCurrentView = () => {
    switch (currentView) {
      case 'dashboard':
        return <SmartTasksDashboard refreshKey={refreshKey} stats={stats} />;
      case 'automation':
        return <TaskAutomationEngine refreshKey={refreshKey} />;
      case 'analytics':
        return <SmartTaskAnalytics refreshKey={refreshKey} />;
      case 'generator':
        return <TaskGenerator refreshKey={refreshKey} />;
      case 'management':
        return <TaskManagement refreshKey={refreshKey} stats={stats} />;
      default:
        return <SmartTasksDashboard refreshKey={refreshKey} stats={stats} />;
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      </div>
    );
  }

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Header */}
      <div className="mb-8">
        <div className="flex items-center justify-between mb-4">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Smart Task Management</h1>
            <p className="text-gray-600 mt-1">
              AI-powered task automation with intelligent workflows and team productivity insights
            </p>
          </div>
          <div className="flex items-center gap-4">
            {/* Quick Stats */}
            <div className="hidden md:flex items-center gap-6 text-sm">
              <div className="flex items-center gap-2">
                <div className="bg-blue-100 p-2 rounded-lg">
                  <FiCheckSquare className="text-blue-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.totalTasks}</div>
                  <div className="text-gray-500">Total Tasks</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-green-100 p-2 rounded-lg">
                  <FiTarget className="text-green-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.completedTasks}</div>
                  <div className="text-gray-500">Completed</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-orange-100 p-2 rounded-lg">
                  <FiClock className="text-orange-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.todaysTasks}</div>
                  <div className="text-gray-500">Today</div>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="bg-purple-100 p-2 rounded-lg">
                  <FiZap className="text-purple-600" />
                </div>
                <div>
                  <div className="font-semibold text-gray-900">{stats.teamProductivity}%</div>
                  <div className="text-gray-500">Productivity</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Smart Navigation */}
        <div className="bg-white rounded-2xl shadow-lg p-2 border border-gray-200">
          <div className="flex space-x-1 overflow-x-auto">
            {smartViews.map((view) => (
              <button
                key={view.id}
                onClick={() => setCurrentView(view.id as TaskView)}
                className={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all whitespace-nowrap relative ${
                  currentView === view.id
                    ? `bg-gradient-to-r ${view.color} text-white shadow-lg`
                    : 'text-gray-600 hover:bg-gray-100'
                }`}
              >
                <view.icon className={`${currentView === view.id ? 'text-white' : 'text-gray-500'}`} />
                <div className="text-left">
                  <div className="font-semibold flex items-center gap-2">
                    {view.name}
                    {view.highlight && currentView === view.id && (
                      <span className="bg-white bg-opacity-20 text-white text-xs px-2 py-1 rounded-full">
                        {view.highlight}
                      </span>
                    )}
                  </div>
                  <div className={`text-xs ${currentView === view.id ? 'text-white text-opacity-90' : 'text-gray-500'}`}>
                    {view.description}
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Content */}
      <motion.div
        key={currentView}
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.3 }}
      >
        {renderCurrentView()}
      </motion.div>
    </div>
  );
}
