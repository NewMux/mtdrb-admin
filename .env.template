# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Tenant and platform defaults. Set these in Vercel for production.
VITE_APP_NAME=MTDRB Fitness
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_TIMEZONE=UTC
VITE_DEFAULT_CURRENCY=AED
VITE_DEFAULT_COUNTRY_CODE=AE
VITE_DEFAULT_VAT_RATE=5
VITE_PLATFORM_CURRENCY=USD
VITE_STARTER_PLAN_NAME=Starter
VITE_STARTER_PRICE=80
VITE_STARTER_EXTRA_LOCATION_PRICE=20
VITE_PRO_PLAN_NAME=Pro
VITE_PRO_PRICE=130
VITE_PRO_EXTRA_LOCATION_PRICE=10

# Optional: production error monitoring (Sentry). Leave unset to disable --
# the app runs normally either way, it just won't report runtime errors.
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Optional: MPGS/CrediMax gateway host checkout.js is loaded from (public,
# not a secret). Defaults to CrediMax's gateway if unset. The API password
# and other MPGS server-side secrets are Edge Function secrets, never set
# here - see env.example for the full list.
# VITE_MPGS_GATEWAY_HOST=credimax.gateway.mastercard.com
