# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Tenant and platform defaults. Set these in Vercel for production.
VITE_APP_NAME=MTDRB Fitness
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_TIMEZONE=UTC
VITE_DEFAULT_CURRENCY=AED
VITE_DEFAULT_COUNTRY_CODE=AE
VITE_DEFAULT_VAT_RATE=5
VITE_PLATFORM_CURRENCY=BHD
VITE_STARTER_PLAN_NAME=Starter
VITE_STARTER_PRICE=20
VITE_STARTER_EXTRA_LOCATION_PRICE=10
VITE_PRO_PLAN_NAME=Pro
VITE_PRO_PRICE=35
VITE_PRO_EXTRA_LOCATION_PRICE=15

# Paddle Billing (platform subscription checkout). Safe to expose --
# a Paddle client token and price IDs are not secrets, the same way a
# Stripe publishable key isn't. See DEPLOYMENT.md's "Payment gateway
# (Paddle)" section for what to configure in Paddle's dashboard first,
# and for the separate, actually-secret paddle-webhook Edge Function vars.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_STARTER_PRICE_ID=
VITE_PADDLE_PRO_PRICE_ID=
# Checkout is OPEN whenever the Paddle values above are set. Set this to exactly
# "false" to pause new subscriptions (customers see "subscriptions are
# unavailable"); leave it unset/blank otherwise. The build fails if checkout
# would be open but a Paddle value is missing or the token doesn't match
# VITE_PADDLE_ENVIRONMENT.
# VITE_CHECKOUT_ENABLED=false

# Optional: production error monitoring (Sentry). Leave unset to disable --
# the app runs normally either way, it just won't report runtime errors.
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Development only: by default `npm run dev` uses an in-memory mock backend
# with a pre-authenticated demo admin session (see src/mocks/). This never
# activates in a production build (npm run build), regardless of what host
# or IP the built app is served from. Set to "true" in your local .env to
# opt out and exercise a real Supabase backend from `npm run dev` instead.
# VITE_FORCE_REAL_CLIENT=false

# Optional bot protection for sign-up / sign-in / password reset: the Cloudflare
# Turnstile SITE key (public). Must be paired with CAPTCHA enabled in Supabase
# Auth using the SECRET key - set both or neither (DEPLOYMENT.md, "Self-serve
# sign-up").
VITE_TURNSTILE_SITE_KEY=
